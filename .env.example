PORT=5000
NODE_ENV=development

# Database Setup
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/

# JWT Setup
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# SMTP / Email Server Details
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
FROM_EMAIL=your_email@gmail.com

# Separated System & Support Mailboxes
SYSTEM_EMAIL_USER=
SYSTEM_EMAIL_PASS=
SYSTEM_EMAIL_FROM_NAME="POD Support Team"
SUPPORT_EMAIL_USER=
SUPPORT_EMAIL_PASS=
SUPPORT_EMAIL_FROM_NAME="POD Support Team"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Delhivery Direct Shipping Configuration
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_API_URL=https://track.delhivery.com
DELHIVERY_WEBHOOK_TOKEN=
